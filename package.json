{
  "name": "eveandlace-storefront",
  "private": true,
  "version": "1.2.8",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "test:coverage": "pnpm --filter web test:coverage",
    "test:e2e": "pnpm --filter web test:e2e",
    "lighthouse:ci": "pnpm exec lhci autorun --config=lighthouserc.cjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "verify": "pnpm audit:prod && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.1.0",
    "proxy-agent": "8.0.2",
    "serve": "14.2.5",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "overrides": {
      "proxy-agent": "8.0.2",
      "source-map-js": "1.2.2"
    }
  }
}
