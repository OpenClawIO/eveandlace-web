{
  "name": "web",
  "private": true,
  "version": "1.2.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:cloudflare": "pnpm build && wrangler deploy",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.mts",
    "test:coverage": "vitest run --coverage --config ../../vitest.config.mts",
    "test:e2e": "playwright test --config ../../playwright.config.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  }
}
